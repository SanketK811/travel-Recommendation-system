# Get a Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Create a Firebase Admin service account JSON file and keep it outside source control.
# Download from: Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Optional named Firestore database ID (leave blank for (default))
FIRESTORE_DATABASE_ID=

# Generate a private, persistent value, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Optional local settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO
